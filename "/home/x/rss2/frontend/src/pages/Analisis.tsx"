import { useEffect, useState, useRef } from 'react'
import { apiService, EntitySuggestion } from '../services/api'
import { LineChart } from '../components/LineChart'
import { X, Search, Activity, AlertCircle } from 'lucide-react'

const TIPOS = [
  { value: '', label: 'All' },
  { value: 'persona', label: 'People' },
  { value: 'lugar', label: 'Places' },
  { value: 'organizacion', label: 'Organizations' },
  { value: 'tema', label: 'Topics' },
]

// Time windows: 24h=1day, 168=7days, 720=30days max
const VENTANAS = [
  { value: 24, label: '1d', hours: 24 },
  { value: 48, label: '2d', hours: 48 },
  { value: 168, label: '7d', hours: 168 },
  { value: 360, label: '15d', hours: 360 },
  { value: 720, label: '30d', hours: 720 },
]

interface Selected {
  valor: string
  tipo: string
}

export function Analisis() {
  const [tipo, setTipo] = useState('')
  const [query, setQuery] = useState('')
  const [results, setResults] = useState<EntitySuggestion[]>([])
  const [selected, setSelected] = useState<Selected[]>([])
  const [ventana, setVentana] = useState(24) // Default to 1 day
  const [series, setSeries] = useState<any[]>([])
  const [loading, setLoading] = useState(false)
  const [searchLoading, setSearchLoading] = useState(false)
  const [showResults, setShowResults] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const searchTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null)
  const abortControllerRef = useRef<AbortController | null>(null)

  useEffect(() => {
    if (!query.trim()) {
      setResults([])
      return
    }

    if (searchTimeoutRef.current) {
      clearTimeout(searchTimeoutRef.current)
    }

    searchTimeoutRef.current = setTimeout(async () => {
      setSearchLoading(true)
      try {
        const data = await apiService.searchEntities({ tipo, q: query.trim(), per_page: 8 })
        setResults(data.entities || [])
      } catch {
        setResults([])
      } finally {
        setSearchLoading(false)
      }
    }, 300)

    return () => {
      if (searchTimeoutRef.current) {
        clearTimeout(searchTimeoutRef.current)
      }
    }
  }, [query, tipo])

  useEffect(() => {
    if (selected.length === 0) {
      setSeries([])
      setError(null)
      return
    }

    // Cancel previous request
    if (abortControllerRef.current) {
      abortControllerRef.current.abort()
    }
    abortControllerRef.current = new AbortController()

    setLoading(true)
    setError(null)

    // Aggressive timeout - 10 seconds for entity evolution
    const timeout = setTimeout(() => {
      if (abortControllerRef.current) {
        abortControllerRef.current.abort()
        setError('Request timed out. Try a smaller time window.')
        setLoading(false)
      }
    }, 10000)

    apiService
      .getEntityMentions({ values: selected.map((s) => s.valor), hours: ventana })
      .then((r) => {
        clearTimeout(timeout)
        setSeries(r.series)
        if (r.series.length === 0 || r.series.every(s => s.data.length === 0)) {
          setError('No data found for selected time window.')
        }
      })
      .catch((err) => {
        clearTimeout(timeout)
        if (err.name === 'AbortError' || err.name === 'CanceledError') {
          return
        }
        setError('Failed to load data. Please try again.')
        console.error('Entity mentions error:', err)
      })
      .finally(() => setLoading(false))

    return () => {
      clearTimeout(timeout)
      if (abortControllerRef.current) {
        abortControllerRef.current.abort()
      }
    }
  }, [selected, ventana])

  const add = (valor: string, t: string) => {
    if (selected.some((s) => s.valor.toLowerCase() === valor.toLowerCase())) return
    setSelected([...selected, { valor, tipo: t }])
    setQuery('')
    setResults([])
    setShowResults(false)
  }

  const remove = (valor: string) => {
    setSelected(selected.filter((s) => s.valor !== valor))
  }

  const retry = () => {
    if (selected.length > 0) {
      setLoading(true)
      setError(null)
      apiService
        .getEntityMentions({ values: selected.map((s) => s.valor), hours: ventana })
        .then((r) => setSeries(r.series))
        .catch(() => setError('Failed to load data. Please try again.'))
        .finally(() => setLoading(false))
    }
  }

  return (
    <div className="space-y-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold text-gray-50">News Evolution</h1>
          <p className="text-base text-gray-400 mt-1">Track entity activity over time</p>
        </div>
      </div>

      <div className="panel">
        <div className="flex flex-col md:flex-row md:items-end gap-4">
          <div>
            <label className="block text-sm font-medium text-gray-300 mb-2">Type</label>
            <select value={tipo} onChange={(e) => setTipo(e.target.value)} className="input py-3">
              {TIPOS.map((t) => (
                <option key={t.value} value={t.value}>
                  {t.label}
                </option>
              ))}
            </select>
          </div>
          <div className="relative flex-1">
            <label className="block text-sm font-medium text-gray-300 mb-2">Search & Add Entity</label>
            <div className="relative">
              <Search className="h-5 w-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" />
              <input
                value={query}
                onChange={(e) => {
                  setQuery(e.target.value)
                  setShowResults(true)
                }}
                onFocus={() => setShowResults(true)}
                placeholder="Search an entity..."
                className="input pl-12 pr-4 py-4 text-lg"
              />
              {searchLoading && (
                <div className="absolute right-4 top-1/2 -translate-y-1/2">
                  <div className="w-5 h-5 border-2 border-gray-600 border-t-primary-50 rounded-full animate-spin" />
                </div>
              )}
            </div>
            {showResults && query.trim() && (
              <ul className="absolute z-20 mt-2 w-full bg-gray-900 border border-gray-700 rounded-xl shadow-2xl max-h-72 overflow-auto">
                {results.length === 0 && !searchLoading && (
                  <li className="px-4 py-3 text-base text-gray-400">No results found</li>
                )}
                {results.map((r) => (
                  <li key={r.valor + r.tipo}>
                    <button
                      onClick={() => add(r.valor, r.tipo)}
                      className="w-full text-left px-4 py-3 text-base hover:bg-gray-800 flex items-center justify-between gap-4 transition-colors"
                    >
                      <span className="text-gray-200 font-medium">{r.valor}</span>
                      <span className="text-sm text-gray-500 font-mono">{r.cnt.toLocaleString()} mentions</span>
                    </button>
                  </li>
                ))}
              </ul>
            )}
          </div>
          <div>
            <label className="block text-sm font-medium text-gray-300 mb-2">Time Window</label>
            <select
              value={ventana}
              onChange={(e) => setVentana(Number(e.target.value))}
              className="input py-3"
            >
              {VENTANAS.map((v) => (
                <option key={v.value} value={v.value}>{v.label}</option>
              ))}
            </select>
          </div>
        </div>

        {selected.length > 0 && (
          <div className="flex flex-wrap gap-3 mt-5 pt-5 border-t border-gray-700">
            {selected.map((s) => (
              <span
                key={s.valor}
                className="inline-flex items-center gap-2 bg-primary-900/30 text-primary-50 text-base px-4 py-2 rounded-xl border border-primary-500/30"
              >
                {s.valor}
                <button onClick={() => remove(s.valor)} className="hover:text-rss-red transition-colors" title="Remove">
                  <X className="h-4 w-4" />
                </button>
              </span>
            ))}
          </div>
        )}
      </div>

      {error && (
        <div className="panel border-rss-red/50 bg-rss-red/10">
          <div className="flex items-center gap-3">
            <AlertCircle className="h-5 w-5 text-rss-red shrink-0" />
            <div className="flex-1">
              <p className="text-base text-rss-red">{error}</p>
            </div>
            <button onClick={retry} className="btn-secondary text-sm">
              Retry
            </button>
          </div>
        </div>
      )}

      {selected.length === 0 ? (
        <div className="panel p-16 text-center">
          <Activity className="w-16 h-16 text-gray-600 mx-auto mb-4" />
          <h3 className="text-xl font-semibold text-gray-300 mb-2">Track entity evolution</h3>
          <p className="text-base text-gray-500">Search and add entities to visualize their activity over time.</p>
        </div>
      ) : loading ? (
        <div className="panel p-16 flex flex-col items-center justify-center">
          <div className="w-12 h-12 border-3 border-gray-700 border-t-primary-50 rounded-full animate-spin mb-4" />
          <p className="text-lg text-gray-400">Loading entity data...</p>
        </div>
      ) : series.length > 0 && series.some(s => s.data.length > 0) ? (
        <div className="panel">
          <LineChart series={series} />
        </div>
      ) : !error ? (
        <div className="panel p-16 text-center">
          <Activity className="w-16 h-16 text-gray-600 mx-auto mb-4" />
          <h3 className="text-xl font-semibold text-gray-300 mb-2">No activity data</h3>
          <p className="text-base text-gray-500">No data found for selected time window.</p>
        </div>
      ) : null}
    </div>
  )
}
"