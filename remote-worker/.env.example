# ==================================================================================
# Configuración de Remote Worker - CPU
# ==================================================================================
# Este archivo es para ejecutar el worker en modo CPU.
# Copia este archivo a .env y configura los valores apropiados.
#
# Uso:
#   cp .env.example .env
#   nano .env
#   docker compose --profile cpu up -d
#
# Requisitos:
#   - CPU con soporte AVX2 (casi todos los CPU modernos)
#   - 4GB+ RAM disponible
#   - ~5GB espacio en disco para el modelo
#   - Sin GPU NVIDIA necesaria
# ==================================================================================

# ==================================================================================
# OBLIGATORIO - Sin estos valores el worker no funcionará
# ==================================================================================

# API Key del worker (generada desde el panel de admin de RSS2)
# La obtienes en: Admin → Workers de Traducción → Añadir Worker
WORKER_API_KEY=rw_tu_api_key_aqui

# URL del servidor WebSocket del servidor RSS2
# Ejemplo producción: wss://rss2.tu-dominio.com/ws/worker
# Ejemplo local: ws://localhost:8080/ws/worker
WORKER_SERVER=ws://tu-servidor:8080/ws/worker

# ==================================================================================
# CONFIGURACIÓN CPU (OBLIGATORIO PARA ESTE MODO)
# ==================================================================================

# Usar CPU (no GPU)
CT2_DEVICE=cpu

# int8 es el único tipo soportado en CPU
CT2_COMPUTE_TYPE=int8

# ==================================================================================
# OPCIONAL
# ==================================================================================

# Nombre identificativo del worker
WORKER_NAME=cpu-worker-1

# Modelo más pequeño para CPU (recomendado para mejor rendimiento)
# facebook/nllb-200-distilled-600M usa menos memoria y es más rápido en CPU
UNIVERSAL_MODEL=facebook/nllb-200-distilled-600M

# Si prefieres el modelo completo (más preciso pero más lento en CPU):
# UNIVERSAL_MODEL=facebook/nllb-200-1.3B

# ==================================================================================
# NOTAS DE RENDIMIENTO CPU
# ==================================================================================
#
# Rendimiento estimado:
#   - Modelo 600M: ~3-5 traducciones/minuto en CPU moderno
#   - Modelo 1.3B: ~1-2 traducciones/minuto en CPU moderno
#
# Memoria RAM necesaria:
#   - 600M: ~2GB RAM
#   - 1.3B: ~4GB RAM
#
# Si tienes problemas de memoria, usa el modelo pequeño:
#   UNIVERSAL_MODEL=facebook/nllb-200-distilled-600M
#
# ==================================================================================
