FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TOKENIZERS_PARALLELISM=false \
    HF_HOME=/cache

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir psycopg2-binary numpy torch sentence-transformers

COPY workers/embeddings_worker.py ./workers/embeddings_worker.py
COPY workers/__init__.py ./workers/__init__.py

ENV DB_HOST=db \
    DB_PORT=5432 \
    DB_NAME=rss \
    DB_USER=rss \
    DB_PASS=x

CMD ["python", "workers/embeddings_worker.py"]
