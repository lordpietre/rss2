# Database Configuration
POSTGRES_DB=rss
POSTGRES_USER=rss
POSTGRES_PASSWORD=change_this_password
DB_NAME=rss
DB_USER=rss
DB_PASS=change_this_password
DB_HOST=db
DB_PORT=5432
DB_WRITE_HOST=db
DB_READ_HOST=db-replica

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Application Secrets
SECRET_KEY=change_this_to_a_long_random_string

# External Services
ALLTALK_URL=http://host.docker.internal:7851

# AI Models & Workers
RSS_MAX_WORKERS=3
# Translation Pipeline
TARGET_LANGS=es
TRANSLATOR_BATCH=16
# Secuencias por llamada a translate_batch. El KV cache de CTranslate2 reserva
# ~24 KB por token y secuencia hasta MAX_SRC_TOKENS + MAX_NEW_TOKENS: 32 seqs
# → ~3.1 GB (OOM con límite 3G), 16 → ~2.6 GB, 8 → ~1.8 GB (estable).
MAX_SEQ_PER_CALL=8
SCHEDULER_BATCH=2000
SCHEDULER_SLEEP=30
LANG_DETECT_BATCH=1000
LANG_DETECT_SLEEP=60

# RSS Ingestor Configuration
RSS_POKE_INTERVAL_MIN=15
RSS_MAX_FAILURES=10
RSS_FEED_TIMEOUT=60

# URL Feed Discovery Worker
URL_DISCOVERY_INTERVAL_MIN=15
URL_DISCOVERY_BATCH_SIZE=10
MAX_FEEDS_PER_URL=5

# CTranslate2 / AI Model Paths
CT2_MODEL_PATH=/app/models/nllb-ct2
CT2_DEVICE=cuda
CT2_COMPUTE_TYPE=int8_float16
UNIVERSAL_MODEL=facebook/nllb-200-distilled-600M

# Embeddings
EMB_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMB_BATCH=64
EMB_DEVICE=cuda

# NER
NER_LANG=es
NER_BATCH=64

# Flask / Gunicorn
GUNICORN_WORKERS=8
FLASK_DEBUG=0

# ---------------------------------------------------------------------------
# Sintesis de voz (TTS) - narraciones de noticias
# ---------------------------------------------------------------------------
# Clave compartida entre el backend Go y el servicio TTS. Si se deja vacia el
# servicio acepta peticiones sin clave (solo aceptable en la red interna).
# Generar con: openssl rand -hex 32
TTS_API_KEY=
# Motores activos. "chatterbox" = motor por defecto (Chatterbox Multilingual
# V3, 23 idiomas, voz por defecto + clon por audio de referencia);
# "melotts" = voz base en espanol; "openvoice" = clon de timbre por embedding
# (los tres necesitan pesos: make tts-models).
TTS_ENGINES=chatterbox,melotts,openvoice
# Motor por defecto: el que usan los trabajos que no piden otro.
TTS_ENGINE=chatterbox
# Idioma y hablante por defecto del modelo (ES = espanol).
TTS_MELO_LANGUAGE=ES
TTS_MELO_SPEAKER_ID=0
# --- Chatterbox -------------------------------------------------------------
# Peso del transformador multilingue: v3 (recomendado), v2 o el nombre
# completo de un .safetensors dentro del directorio de pesos.
TTS_CHATTERBOX_T3_MODEL=v3
# Idioma por defecto (codigo de 2 letras: es, en, fr, pt, zh, ja...).
TTS_CHATTERBOX_LANGUAGE=es
# Controles expresivos. Los de Chatterbox (0.5 / 0.5) van bien para locucion
# neutra; subir exaggeration da mas dramatismo y bajar cfg_weight relaja el
# ritmo. "speed" no es nativo: se aplica despues con phase vocoder.
TTS_CHATTERBOX_EXAGGERATION=0.5
TTS_CHATTERBOX_CFG_WEIGHT=0.5
TTS_CHATTERBOX_TEMPERATURE=0.8
TTS_CHATTERBOX_REPETITION_PENALTY=1.2
# CPU por defecto: la maquina no tiene GPU.
TTS_DEVICE=cpu
# Hilos de torch. No se cambia sin medir: cada hilo consume memoria.
TTS_TORCH_THREADS=2
# Limite de caracteres de un guion (guion largo = minutos de CPU).
TTS_MAX_SCRIPT_CHARS=8000
# Reintentos por tarea antes de darla por fallida.
TTS_MAX_ATTEMPTS=2
# Registro de muestras de voz propias: 0 deshabilitado, 1 habilitado.
# Requiere permisos de administrador.
TTS_ALLOW_VOICE_UPLOAD=0
