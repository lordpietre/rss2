# ==================================================================================
# RSS2 Data & Models (downloaded at runtime)
# ==================================================================================
# ML Models - downloaded/converted by workers
models/
models/nllb-ct2/
models/nllb-ct2-1.3b/
# El patron "models/" tambien alcanzaba el paquete Go backend/internal/models
# (que ya estaba versionado): se excluye de forma explicita para que los
# ficheros nuevos de ese paquete no se queden sin seguimiento.
!backend/internal/models/

# Wikipedia images - downloaded by wiki_worker
data/wiki_images/
data/backups/
data/backup/
backups/

# Narraciones de voz (TTS): audios generados, muestras de voz propias y
# temporales. Nunca se versionan: son datos y material personal.
data/tts_audio/
data/tts_voices/
data/tts_tmp/
models/openvoice/
models/chatterbox/

# Database storage (PostgreSQL)
data/pgdata/
pgdata/
pgdata-replica/
pgdata.failed_restore/
pgdata-replica.old.*/

# Redis data
data/redis-data/
redis-data/

# Monitoring data en runtime (la config de provisioning SÍ se versiona)
data/prometheus/
data/grafana/

# HuggingFace cache (downloaded models)
hf_cache/
.hf-cache/

# Monitoring data
monitoring/data/

# ==================================================================================
# Backup files
# ==================================================================================
*.sql
!init-db/*.sql
!migrations/*.sql
backup_*.sql
*.rdb
redis_backup_*.rdb

